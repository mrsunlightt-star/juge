<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 支付下单/查单：访问支付后端接口 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- targetSdk 30+ 的包可见性声明：缺少此声明时支付宝 SDK 会退化为 H5 收银台，无法拉起支付宝 App -->
    <queries>
        <package android:name="com.eg.android.AlipayGphone" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        
        <!-- 主编辑页面 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 桌面长按图标弹出的快捷方式：一键添加 4×4 / 4×2 组件 -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- 快捷编辑悬浮窗，配置为 Dialog 主题 -->
        <activity
            android:name=".QuickAdjustActivity"
            android:exported="false"
            android:theme="@style/Theme.QuickAdjustDialog"
            android:windowSoftInputMode="adjustResize" />

        <!-- 桌面 Widget 主入口：默认落位 4×4，可在 2~4 行之间拖拽缩放 -->
        <receiver
            android:name=".ReminderWidgetProvider"
            android:exported="true"
            android:label="句阁 4×4">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="miui.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
            <!-- MIUI/HyperOS Widget 曝光刷新标识 -->
            <meta-data
                android:name="miuiWidget"
                android:value="true" />
            <meta-data
                android:name="miuiWidgetRefresh"
                android:value="exposure" />
            <meta-data
                android:name="miuiWidgetRefreshMinInterval"
                android:value="10000" />
        </receiver>

        <!-- 桌面 Widget 紧凑入口：默认落位 4×2，同样可拖拽放大到 4 行 -->
        <receiver
            android:name=".ReminderWidgetProviderCompact"
            android:exported="true"
            android:label="句阁 4×2">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="miui.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_compact" />
            <!-- MIUI/HyperOS Widget 曝光刷新标识 -->
            <meta-data
                android:name="miuiWidget"
                android:value="true" />
            <meta-data
                android:name="miuiWidgetRefresh"
                android:value="exposure" />
            <meta-data
                android:name="miuiWidgetRefreshMinInterval"
                android:value="10000" />
        </receiver>

    </application>

</manifest>