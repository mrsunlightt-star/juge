<vector
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="300dp"
    android:height="120dp"
    android:viewportWidth="300"
    android:viewportHeight="120"
>
    <!--
        满幅纯色底：整张组件位图的蓝色卡片面。
        不能在这里做圆角——素材按组件尺寸栅格化后，烘焙圆角的四个角是透明的，
        会露出下层背景色（渐变/底色），桌面上表现为组件四角的异色楔块；
        组件的圆角由渲染器的 outerPath 按用户圆角滑条统一裁切（见 WidgetCanvasRenderer.render）。
    -->
    <path
        android:pathData="M0 0H300V120H0"
        android:fillColor="#1E6DD0"
    />
</vector>
