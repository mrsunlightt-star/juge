<?xml version="1.0" encoding="utf-8"?>
<!--
  4×4 入口在「组件选择器」里的预览。

  为什么要单独一张布局：Android 12+ 的桌面优先使用 appwidget-provider 里的
  previewLayout，而它只会被静态 inflate —— 里面没有任何运行时绑定，所以必须有
  静态图源，否则选择器里就是一块空白（旧版指向的 widget_layout 就是这种情况）。
  这里的图与 previewImage 是同一张，老桌面走 previewImage、12+ 走这张，两路一致。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:padding="0dp">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_preview_big"
        android:contentDescription="@string/app_name" />
</FrameLayout>
