<full-backup-content>
    <!-- 备份数据库（含 WAL/SHM 附带文件，否则最近写入会丢失） -->
    <include domain="database" path="."/>

    <!-- 备份用户自定义背景图，避免恢复后样式引用失效（编辑期临时图在 bg_tmp，不在备份范围） -->
    <include domain="file" path="bg_images/"/>

    <!-- 备份 SharedPreferences，但排除凭证/同意状态/设备绑定数据 -->
    <include domain="sharedpref" path="."/>

    <!-- 付费激活状态与设备绑定数据：恢复后无意义，且属于敏感状态 -->
    <exclude domain="sharedpref" path="trial_activation_v2_prefs.xml"/>
    <exclude domain="sharedpref" path="widget_bindings_prefs.xml"/>

    <!-- 登录凭证（Bearer Token）：不随普通 App 数据备份，新设备重新登录即可 -->
    <exclude domain="sharedpref" path="account_prefs.xml"/>

    <!-- 隐私同意状态：新设备应重新征求同意，不静默继承 -->
    <exclude domain="sharedpref" path="consent_prefs.xml"/>

    <!-- 旧版合并文件：可能残留 privacy_accepted，一并排除 -->
    <exclude domain="sharedpref" path="app_settings.xml"/>

    <!-- user_prefs.xml（用户自定义颜色等）不排除：属于用户资产，应随备份恢复 -->
</full-backup-content>